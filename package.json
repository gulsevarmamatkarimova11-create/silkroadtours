{
  "name": "silkroad-tours",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "db:new-migration": "wrangler d1 migrations create silkroad-tours-db",
    "db:migrate:local": "wrangler d1 migrations apply silkroad-tours-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply silkroad-tours-db --remote",
    "db:seed:build": "tsx scripts/build-seed-sql.ts",
    "db:seed:local": "npm run db:seed:build && wrangler d1 execute silkroad-tours-db --local --file=drizzle/seed.sql",
    "db:seed:remote": "npm run db:seed:build && wrangler d1 execute silkroad-tours-db --remote --file=drizzle/seed.sql",
    "db:studio": "drizzle-kit studio",
    "db:seed:reset:local": "tsx scripts/build-seed-sql.ts --reset && wrangler d1 execute silkroad-tours-db --local --file=drizzle/seed.sql",
    "db:check": "python3 scripts/check-schema-parity.py",
    "db:reset:local": "rm -rf .wrangler/state && npm run db:migrate:local && npm run db:seed:local",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:smoke": "node scripts/smoke-test.mjs",
    "setup:codespace": "bash scripts/codespace-setup.sh",
    "test:e2e": "playwright test",
    "test:lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@opennextjs/cloudflare": "^1.20.17",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.12",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.542.0",
    "next": "15.5.29",
    "next-intl": "^4.3.5",
    "react": "19.1.10",
    "react-day-picker": "^9.9.0",
    "react-dom": "19.1.10",
    "react-hook-form": "^7.62.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "yet-another-react-lightbox": "^3.33.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261117.1",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.4",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "wrangler": "^4.164.0"
  }
}
