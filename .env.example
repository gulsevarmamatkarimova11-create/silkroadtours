# ─────────────────────────────────────────────────────────────────────────
# Where each value lives
#   BUILD-TIME (.env locally, "Build variables" in Cloudflare Workers Builds / GitHub Actions)
#     NEXT_PUBLIC_* values are inlined into the client bundle at `next build`.
#   RUNTIME SECRETS (.dev.vars locally, `wrangler secret put` in production)
#     Read on the server via getCloudflareContext().env — never exposed to the browser.
#   CLI ONLY (.env locally, GitHub repository secrets in CI)
#     Used by wrangler / drizzle-kit, not by the app.
#
# Note: there is no DATABASE_URL. Cloudflare D1 is attached as the `DB` binding
# in wrangler.toml, so the Worker never needs a connection string.
# ─────────────────────────────────────────────────────────────────────────

# ── Build-time public values ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=998901234567
NEXT_PUBLIC_TELEGRAM_USERNAME=silkroad_tours_uz
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ── Runtime secrets (copy into .dev.vars for local dev) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SESSION_SECRET=
ADMIN_SECRET=
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── CLI / CI only ──
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=
