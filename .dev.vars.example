# Local runtime secrets for `next dev` and `opennextjs-cloudflare preview`.
# Copy to .dev.vars (git-ignored). Production values: `npx wrangler secret put <NAME>`.

# Bot from @BotFather; chat id of the admin group (negative number, e.g. -1001234567890).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Generate with: openssl rand -base64 32
SESSION_SECRET=
ADMIN_SECRET=

# Cloudflare's official always-pass test key, for local dev only.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
